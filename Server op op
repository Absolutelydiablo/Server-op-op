--[[
    Server Hopper - Unified Script (Theme + Image)
]]

print("[Hopper] Script started")

local ok, err = pcall(function()
    local Players          = game:GetService("Players")
    local TeleportService  = game:GetService("TeleportService")
    local HttpService      = game:GetService("HttpService")
    local UserInputService = game:GetService("UserInputService")
    local TweenService     = game:GetService("TweenService")
    local CoreGui          = game:GetService("CoreGui")
    local Lighting         = game:GetService("Lighting")

    local player  = Players.LocalPlayer
    local placeId = game.PlaceId

    -- === HTTP ===
    local function getRequestFunction()
        return (syn and syn.request) or (http and http.request)
            or (fluxus and fluxus.request) or http_request or request
    end
    local requestFunc = getRequestFunction()
    if not requestFunc then
        error("Инжектор не поддерживает HTTP-запросы")
    end

    local now
    if os and os.clock then now = os.clock
    elseif tick then now = tick
    else now = function() return os.time() end end

    -- === КЭШ ===
    local cachedServers = {}
    local cacheTime = 0
    local CACHE_DURATION = 60

    local function fetchServers(ignoreCache)
        if not ignoreCache and #cachedServers > 0
            and (now() - cacheTime) < CACHE_DURATION then
            return cachedServers, true
        end

        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"):format(placeId)
        print("[Hopper] Requesting (primary):", url)
        local ok1, response = pcall(requestFunc, {Url = url, Method = "GET"})

        if not ok1 or not response or not response.Body or (response.StatusCode and response.StatusCode ~= 200) then
            warn("[Hopper] Primary failed, trying proxy...")
            local proxyUrl = ("https://games.roproxy.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"):format(placeId)
            ok1, response = pcall(requestFunc, {Url = proxyUrl, Method = "GET"})
        end

        if not ok1 or not response or not response.Body then
            warn("[Hopper] All requests failed.")
            return cachedServers, false
        end

        local ok2, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if not ok2 or type(data) ~= "table" or type(data.data) ~= "table" then
            warn("[Hopper] JSON decode failed.")
            return cachedServers, false
        end

        local servers = {}
        for _, server in ipairs(data.data) do
            if server.id ~= game.JobId and tonumber(server.playing) < tonumber(server.maxPlayers) then
                table.insert(servers, {
                    id = server.id,
                    playing = tonumber(server.playing),
                    maxPlayers = tonumber(server.maxPlayers),
                })
            end
        end
        table.sort(servers, function(a, b) return a.playing < b.playing end)
        cachedServers = servers
        cacheTime = now()
        print("[Hopper] Fetched servers:", #servers)
        return servers, true
    end

    -- === GUI PARENT ===
    local function getGuiParent()
        if gethui then
            local okG, h = pcall(gethui)
            if okG and h then return h end
        end
        return CoreGui
    end

    local guiParent = getGuiParent()
    pcall(function()
        local old = guiParent:FindFirstChild("ServerHopperGui")
        if old then old:Destroy() end
    end)

    -- === BLUR + ЦВЕТ ===
    local BLUR_NAME = "ServerHopperBlur"
    local CC_NAME   = "ServerHopperCC"
    local BLUR_EXPANDED = 18
    local CC_BRIGHT_EXPANDED = -0.18

    pcall(function()
        local oldBlur = Lighting:FindFirstChild(BLUR_NAME)
        if oldBlur then oldBlur:Destroy() end
        local oldCC = Lighting:FindFirstChild(CC_NAME)
        if oldCC then oldCC:Destroy() end
    end)

    local blur = Instance.new("BlurEffect")
    blur.Name = BLUR_NAME
    blur.Size = BLUR_EXPANDED
    blur.Parent = Lighting

    local colorCorrection = Instance.new("ColorCorrectionEffect")
    colorCorrection.Name = CC_NAME
    colorCorrection.Brightness = CC_BRIGHT_EXPANDED
    colorCorrection.Contrast   = 0.06
    colorCorrection.Saturation = -0.1
    colorCorrection.Parent = Lighting

    -- === КОНСТАНТЫ ===
